{
  "name": "kovedit",
  "version": "0.1.0",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo '' && husky",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "pnpm check && pnpm lint:comments",
    "lint:comments": "eslint . && cargo dylint --all -- --all-targets",
    "format": "prettier --write . && rustfmt src-tauri/build.rs src-tauri/src/*.rs lints/no_source_comments/src/*.rs",
    "format:check": "prettier --check . && rustfmt --check src-tauri/build.rs src-tauri/src/*.rs lints/no_source_comments/src/*.rs",
    "test": "cargo test -p kovedit",
    "tauri": "tauri"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-plugin-no-comments": "^1.2.1",
    "eslint-plugin-svelte": "^3.24.1",
    "husky": "^9.1.7",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.0.16"
  }
}
