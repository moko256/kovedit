{
  "name": "kovedit",
  "version": "0.1.0",
  "description": "",
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo '' && husky",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "pnpm lint:js && pnpm lint:rust",
    "lint:js": "pnpm check && eslint .",
    "lint:rust": "cargo dylint --all --manifest-path src-tauri/Cargo.toml -- --all-targets",
    "lint:comments": "pnpm lint:js && pnpm lint:rust",
    "format": "prettier --write . && rustfmt src-tauri/app/build.rs src-tauri/app/src/*.rs src-tauri/lints/no_source_comments/src/*.rs",
    "format:check": "prettier --check . && rustfmt --check src-tauri/app/build.rs src-tauri/app/src/*.rs src-tauri/lints/no_source_comments/src/*.rs",
    "test": "cargo test -p kovedit --manifest-path src-tauri/Cargo.toml",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "tauri": "tauri"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "mediabunny": "^1.66.0"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.75.0",
    "@playwright/cli": "^0.1.24",
    "@playwright/test": "^1.65.1",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-svelte-csf": "^5.1.6",
    "@storybook/sveltekit": "^10.6.7",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@7.0.2",
    "bits-ui": "^2.21.0",
    "cn": "^0.5.2",
    "eslint": "^10.15.0",
    "eslint-plugin-no-comments": "^1.2.1",
    "eslint-plugin-svelte": "^3.24.1",
    "husky": "^9.1.7",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn-svelte": "^1.8.1",
    "storybook": "^10.6.7",
    "svelte": "^5.57.1",
    "svelte-check": "^4.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.0.16",
    "vitest": "5.1.0"
  }
}
